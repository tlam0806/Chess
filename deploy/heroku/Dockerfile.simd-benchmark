FROM ubuntu:24.04 AS engine-build

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY CMakeLists.txt ./
COPY include ./include
COPY src ./src
COPY tools ./tools
COPY tests ./tests
RUN cmake -S . -B build-release -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build-release \
       --target phase_quantized_nnue_tests uci_nnue_v41 -j 2

FROM ubuntu:24.04

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       ca-certificates python3 python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/chess-engine
COPY --from=engine-build /src/build-release/phase_quantized_nnue_tests \
    ./build-release/phase_quantized_nnue_tests
COPY --from=engine-build /src/build-release/uci_nnue_v41 \
    ./build-release/uci_nnue_v41
COPY models ./models
COPY benchmarks/uci_platform_v1.json ./benchmarks/uci_platform_v1.json
COPY deploy/heroku/benchmark-config-v41.yml \
    ./deploy/heroku/benchmark-config-v41.yml
COPY tools/benchmark_uci_platform.py ./tools/benchmark_uci_platform.py
COPY tools/run_nnue_backend_matrix_remote.py \
    ./tools/run_nnue_backend_matrix_remote.py
RUN chmod +x \
      ./build-release/phase_quantized_nnue_tests \
      ./build-release/uci_nnue_v41 \
      ./tools/benchmark_uci_platform.py \
      ./tools/run_nnue_backend_matrix_remote.py

# This image is only a source for explicitly requested one-off dynos.  The
# corresponding process formation is kept at zero by the staging script.
CMD ["/bin/true"]
